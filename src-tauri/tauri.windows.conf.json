{
  "bundle": {
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "compression": "lzma",
        "installerHooks": "nsis/uninstall.nsh",
        "languages": ["English", "SimpChinese", "TradChinese"],
        "displayLanguageSelector": true,
        "startMenuFolder": "TieZ"
      }
    }
  }
}
